# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# NOTE: src-tauri/icons/ is deliberately NOT ignored — `tauri build` reads the
# bundle icons from there, so they have to be committed. Regenerate them from
# the master artwork with:  npm run tauri icon Assets/<name>.icns
src-tauri/icons/new_icon2.png

# yt-dlp is bundled into the app but fetched at build time — it is tens of MB
# per platform, and that does not belong in git history.
# Populate with:  npm run fetch-ytdlp
src-tauri/binaries/

# macOS writes a custom-folder-icon file whose name ends in a carriage return,
# so a bare `Icon` rule does not match it — the `?` is that trailing character.
Icon?

# Claude Code's per-machine settings. `.claude/` itself is deliberately NOT
# ignored: shared project config belongs in git, only the *.local one doesn't.
.claude/settings.local.json
